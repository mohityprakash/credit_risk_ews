OPENAI_API_KEY=
NEWS_PROVIDER=gdelt
GDELT_QUERY=(credit OR downgrade OR default OR bankruptcy OR liquidity stress OR covenant breach)
DATABASE_URL=sqlite:///./data/credit_risk_ews.db
ENABLE_LLM_ENRICHMENT=false
INGEST_LOOKBACK_HOURS=24
MAX_ARTICLES_PER_RUN=50
OPENAI_MODEL=gpt-4o-mini
RISK_MOMENTUM_MENTION_SPIKE_WEIGHT=0.35
RISK_MOMENTUM_NEGATIVE_SHARE_WEIGHT=0.30
RISK_MOMENTUM_SEVERITY_WEIGHT=0.25
RISK_MOMENTUM_SOURCE_DIVERSITY_WEIGHT=0.10
